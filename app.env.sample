# Arrstack - *arr media management stack
# Copy to app.env and fill in your values

# Timezone
TZ=America/New_York

# Hostname
BASE_HOST_NAME=$HOSTNAME

# User/group IDs for file permissions
SERVICE_USER=1000
SERVICE_GROUP=1000

# Transmission web UI credentials
APP_ADMIN_USER=admin
APP_ADMIN_PASS=changeme_admin_password

# Homarr encryption key (must be at least 32 characters)
ENCRYPTION_KEY=changeme_encryption_key_min_32_chars
